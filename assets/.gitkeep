const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

const scoreEl = document.getElementById('score');
const bestScoreEl = document.getElementById('best-score');
const livesEl = document.getElementById('lives');
const overlayEl = document.getElementById('overlay');
const startButton = document.getElementById('startButton');

const keys = {};
const starfield = [];
const bullets = [];
const enemyBullets = [];
const enemies = [];

const player = {
  x: canvas.width / 2,
  y: canvas.height - 60,
  width: 30,
  height: 30,
  speed: 5,
  cooldown: 0,
};

let score = 0;
let bestScore = Number(localStorage.getItem('spaceShooterBest') || 0);
let lives = 3;
let running = false;
let lastTime = 0;
let enemyTimer = 0;
let gameOver = false;

bestScoreEl.textContent = bestScore;

function resetGame() {
  score = 0;
  lives = 3;
  gameOver = false;
  bullets.length = 0;
  enemyBullets.length = 0;
  enemies.length = 0;
  player.x = canvas.width / 2;
  player.y = canvas.height - 60;
  player.cooldown = 0;
  scoreEl.textContent = score;
  livesEl.textContent = lives;
  enemyTimer = 0;
  overlayEl.classList.add('hidden');
  running = true;
}

function spawnStars() {
  for (let i = 0; i < 90; i += 1) {
    starfield.push({
      x: Math.random() * canvas.width,
      y: Math.random() * canvas.height,
      radius: Math.random() * 2 + 1,
      speed: Math.random() * 1.25 + 0.5,
    });
  }
}

function spawnEnemy() {
  const size = 22 + Math.random() * 16;
  enemies.push({
    x: Math.random() * (canvas.width - size),
    y: -size,
    width: size,
    height: size,
    speed: 1 + Math.random() * 1.6,
    drift: (Math.random() - 0.5) * 1.5,
  });
}

function shoot() {
  if (!running || player.cooldown > 0) return;

  bullets.push({
    x: player.x,
    y: player.y - 18,
    width: 4,
    height: 12,
    speed: 8,
  });

  player.cooldown = 180;
}

function enemyShoot(enemy) {
  enemyBullets.push({
    x: enemy.x + enemy.width / 2,
    y: enemy.y + enemy.height,
    width: 4,
    height: 12,
    speed: 4,
  });
}

function handleInput() {
  if (keys.ArrowLeft) player.x -= player.speed;
  if (keys.ArrowRight) player.x += player.speed;
  if (keys.ArrowUp) player.y -= player.speed;
  if (keys.ArrowDown) player.y += player.speed;

  player.x = Math.max(20, Math.min(canvas.width - 20, player.x));
  player.y = Math.max(40, Math.min(canvas.height - 30, player.y));
}

function updateBullets() {
  for (let i = bullets.length - 1; i >= 0; i -= 1) {
    bullets[i].y -= bullets[i].speed;
    if (bullets[i].y < -10) bullets.splice(i, 1);
  }

  for (let i = enemyBullets.length - 1; i >= 0; i -= 1) {
    enemyBullets[i].y += enemyBullets[i].speed;
    if (enemyBullets[i].y > canvas.height + 20) enemyBullets.splice(i, 1);
  }
}

function updateEnemies(delta) {
  enemyTimer -= delta;
  if (enemyTimer <= 0 && running) {
    spawnEnemy();
    enemyTimer = Math.max(550, 1200 - score * 4);
  }

  for (let i = enemies.length - 1; i >= 0; i -= 1) {
    const enemy = enemies[i];
    enemy.y += enemy.speed;
    enemy.x += enemy.drift;

    if (Math.random() < 0.012) {
      enemyShoot(enemy);
    }

    if (enemy.y > canvas.height + enemy.height) {
      enemies.splice(i, 1);
      lives -= 1;
      livesEl.textContent = lives;
      if (lives <= 0) endGame();
      continue;
    }

    if (enemy.x < 0 || enemy.x + enemy.width > canvas.width) {
      enemy.drift *= -1;
      enemy.x = Math.max(0, Math.min(canvas.width - enemy.width, enemy.x));
    }
  }
}

function checkCollisions() {
  for (let i = bullets.length - 1; i >= 0; i -= 1) {
    const bullet = bullets[i];

    for (let j = enemies.length - 1; j >= 0; j -= 1) {
      const enemy = enemies[j];
      if (
        bullet.x > enemy.x &&
        bullet.x < enemy.x + enemy.width &&
        bullet.y > enemy.y &&
        bullet.y < enemy.y + enemy.height
      ) {
        bullets.splice(i, 1);
        enemies.splice(j, 1);
        score += 10;
        scoreEl.textContent = score;
        break;
      }
    }
  }

  for (let i = enemyBullets.length - 1; i >= 0; i -= 1) {
    const bullet = enemyBullets[i];
    if (
      bullet.x > player.x - player.width / 2 &&
      bullet.x < player.x + player.width / 2 &&
      bullet.y > player.y - player.height / 2 &&
      bullet.y < player.y + player.height / 2
    ) {
      enemyBullets.splice(i, 1);
      lives -= 1;
      livesEl.textContent = lives;
      if (lives <= 0) endGame();
    }
  }
}

function endGame() {
  running = false;
  gameOver = true;
  bestScore = Math.max(bestScore, score);
  localStorage.setItem('spaceShooterBest', bestScore);
  bestScoreEl.textContent = bestScore;
  overlayEl.innerHTML = `
    <h1>Game Over</h1>
    <p>Your score: ${score}</p>
    <button id="startButton">Play Again</button>
  `;
  document.getElementById('startButton').addEventListener('click', () => {
    overlayEl.innerHTML = `
      <h1>Space Shooter</h1>
      <p>Use arrow keys to move and space to fire.</p>
      <button id="startButton">Start Game</button>
    `;
    document.getElementById('startButton').addEventListener('click', resetGame);
    resetGame();
  });
  overlayEl.classList.remove('hidden');
}

function drawBackground() {
  ctx.fillStyle = '#060d1f';
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  for (const star of starfield) {
    ctx.fillStyle = 'rgba(255,255,255,0.8)';
    ctx.beginPath();
    ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
    ctx.fill();

    star.y += star.speed;
    if (star.y > canvas.height) {
      star.y = 0;
      star.x = Math.random() * canvas.width;
    }
  }
}

function drawPlayer() {
  ctx.save();
  ctx.translate(player.x, player.y);

  ctx.fillStyle = '#8ed2ff';
  ctx.beginPath();
  ctx.moveTo(0, -16);
  ctx.lineTo(14, 16);
  ctx.lineTo(0, 10);
  ctx.lineTo(-14, 16);
  ctx.closePath();
  ctx.fill();

  ctx.fillStyle = '#ffd166';
  ctx.fillRect(-2, 10, 4, 8);
  ctx.restore();
}

function drawBullets() {
  ctx.fillStyle = '#7be0ff';
  for (const bullet of bullets) {
    ctx.fillRect(bullet.x - bullet.width / 2, bullet.y - bullet.height / 2, bullet.width, bullet.height);
  }

  ctx.fillStyle = '#ff7a7a';
  for (const bullet of enemyBullets) {
    ctx.fillRect(bullet.x - bullet.width / 2, bullet.y - bullet.height / 2, bullet.width, bullet.height);
  }
}

function drawEnemies() {
  for (const enemy of enemies) {
    ctx.fillStyle = '#ff6b6b';
    ctx.fillRect(enemy.x, enemy.y, enemy.width, enemy.height);
    ctx.fillStyle = '#ffd2d2';
    ctx.fillRect(enemy.x + 6, enemy.y + 8, enemy.width - 12, 6);
  }
}

function draw() {
  drawBackground();
  drawEnemies();
  drawBullets();
  drawPlayer();
}

function loop(timestamp) {
  const delta = timestamp - lastTime || 16;
  lastTime = timestamp;

  if (running) {
    handleInput();
    updateBullets();
    updateEnemies(delta);
    checkCollisions();
    if (player.cooldown > 0) player.cooldown -= delta;
  }

  draw();
  requestAnimationFrame(loop);
}

window.addEventListener('keydown', (event) => {
  keys[event.key] = true;

  if (event.key === ' ' && running) {
    event.preventDefault();
    shoot();
  }

  if (event.key === 'Enter' && gameOver) {
    resetGame();
  }
});

window.addEventListener('keyup', (event) => {
  keys[event.key] = false;
});

startButton.addEventListener('click', resetGame);
spawnStars();
requestAnimationFrame(loop);
